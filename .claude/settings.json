{
  "allowedTools": [
    "Read",
    "Write",
    "Edit",
    "Bash",
    "Bash(git:*)",
    "Bash(python:*)",
    "Bash(java:*)",
    "Bash(./build.sh:*)",
    "Bash(./build.py:*)",
    "Bash(cd:*)",
    "Bash(mkdir:*)",
    "Bash(find:*)",
    "Glob",
    "Grep",
    "TodoWrite",
    "Task",
    "WebFetch",
    "WebSearch"
  ],
  "autoApproveReads": true,
  "autoApproveGitOperations": false,
  "projectContext": {
    "name": "OASIS UBL Standard Development",
    "type": "standards-development",
    "organization": "OASIS",
    "primaryLanguages": [
      "python",
      "xml",
      "xslt",
      "bash"
    ],
    "buildSystem": "ant+python",
    "cicd": "github-actions",
    "version": "2.5",
    "stage": "csd01"
  },
  "gitWorkflow": {
    "featureBranchPrefix": "claude/",
    "requireSessionId": true,
    "mainBranches": [
      "main",
      "master",
      "ubl-2.5-python"
    ],
    "protectedBranches": [
      "main",
      "master"
    ]
  },
  "buildConfiguration": {
    "localBuildCommand": "python build.py target local debug",
    "testCommand": "cd raw/val && ./test.sh && ./testsamples.sh",
    "targetDirectory": "target",
    "artifactPattern": "*.7z"
  },
  "filePatterns": {
    "autoGenerated": [
      "**/*-ent.xml",
      "**/summary-*.xml"
    ],
    "doNotEdit": [
      "**/*-ent.xml",
      "**/UBL-Entities-*.gc",
      "**/build.console.*.txt",
      "**/build.exitcode.*.txt"
    ],
    "requiresVersionUpdate": [
      "build.sh",
      "build.py",
      "UBL.xml",
      "config-UBL.xml",
      "raw/xsd/common/UBL-*.xsd"
    ]
  },
  "documentation": {
    "readmeFirst": [
      "README.md",
      ".claude/CLAUDE.md",
      "ENVIRONMENT_SETUP.md"
    ],
    "architectureDocs": [
      ".claude/docs/architecture.md",
      "architecture.png"
    ]
  }
}
