digraph UBL_Branch_Graph {
    rankdir=TB;
    bgcolor="#0d1117";
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.15,0.08"];
    edge [fontname="Helvetica", fontsize=8, color="#484f58"];
    label="oasis-tcs/ubl — Complete Branch Interconnection Graph\nAll 27 branches in ONE connected tree (root: 71129c9, 2018-04-11)\n(updated 2026-04-02 — recovered 40 lost commits reconnecting full history)";
    labelloc=t;
    labeljust=l;
    fontcolor="#58a6ff";
    fontsize=14;

    // ===== LEGEND =====
    subgraph cluster_legend {
        label="Legend";
        labeljust=l;
        fontcolor="#58a6ff";
        fontsize=12;
        style=dashed;
        color="#30363d";
        bgcolor="#161b22";

        leg1 [label="Branch tip", fillcolor="#1a3a1a", fontcolor="#7ee787", shape=box];
        leg2 [label="★ Release commit (verified)", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=2, color="#7ee787"];
        leg3 [label="Key commit / merge-base", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=ellipse];
        leg4 [label="Force-pushed / changed branch", fillcolor="#3a2a0a", fontcolor="#d29922", shape=box];
        leg5 [label="PR merge commit", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=octagon];
        leg6 [label="Recovered commits (were unreachable)", fillcolor="#2a1a2a", fontcolor="#d2a8ff", shape=box, style="filled,dashed"];
        leg1 -> leg2 -> leg3 -> leg4 -> leg5 -> leg6 [style=invis];
    }

    // ============================================================
    // SINGLE CONNECTED TREE (root: 71129c9, 2018-04-11)
    // 27 branches, all connected via recovered history
    // ============================================================

    // Root
    root [label="71129c9\n2018-04-11\n\"Initial repo boilerplate\"\n(Robin Cover)", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=ellipse];

    // ---- UBL 2.3 ----
    subgraph cluster_23 {
        label="UBL 2.3 lineage";
        fontcolor="#79c0ff";
        fontsize=10;
        style=dashed;
        color="#1a2a3a";
        bgcolor="#0d1117";

        csd05copy [label="ubl-2.3-csd05-copy\n57dda2e  (7 commits)\n2021-05-16\n\"Rebuild results on edit branch\"", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        cs02 [label="★ ubl-2.3-cs02\n47eb1f5  (8 commits)\n2021-05-23\n\"First attempt at CS02\"", fillcolor="#1a4a1a", fontcolor="#7ee787", penwidth=2, color="#7ee787"];

        pivot [label="f71d2be\n2021-05-26\n\"Add polish to README\"\nPIVOT — ancestor of\nmain + all 2.4/2.5 branches", fillcolor="#1a2a3a", fontcolor="#ffa657", shape=ellipse, penwidth=2, color="#ffa657"];

        pr1 [label="6d153bf\nPR #1\ncsd05-copy → review", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=octagon, fontsize=8];

        os23 [label="★ ubl-2.3-os\nbc99520  (16 commits)\n2021-06-18\n\"Repair text in Status section\"", fillcolor="#1a4a1a", fontcolor="#7ee787", penwidth=2, color="#7ee787"];
        osiso23 [label="ubl-2.3-os-iso\nbc99520 (= ubl-2.3-os)\n2021-06-18  IDENTICAL", fillcolor="#1a3a1a", fontcolor="#7ee787"];
    }

    review [label="review\n876778c  (19 commits)\n2023-02-01\n\"Added Purchase Order example\"", fillcolor="#1a3a1a", fontcolor="#7ee787"];
    main [label="main\nc12b81a  (13 commits)\n2025-10-08\n\"sync main repo build.yml\"", fillcolor="#1a3a1a", fontcolor="#7ee787"];

    // ---- UBL 2.4 ----
    subgraph cluster_24 {
        label="UBL 2.4 lineage  (PRs #4-#27)";
        fontcolor="#79c0ff";
        fontsize=10;
        style=dashed;
        color="#1a2a3a";
        bgcolor="#0d1117";

        csd01wd01 [label="ubl-2.4-csd01wd01\n21efa9e  (39 commits)\n2021-06-01", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        csd01wd02 [label="ubl-2.4-csd01wd02\n33d4527  (142 commits)\n2023-02-07\nReceived PRs #4-#20", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        csd01 [label="★ ubl-2.4-csd01\nRelease: 2e3c601 (08 Feb 2023)\nTip: 0b0b0b3  (168 commits)\n2023-09-26  \"Merge PR #24\"", fillcolor="#1a4a1a", fontcolor="#7ee787", penwidth=2, color="#7ee787"];

        csd02prd [label="ubl-2.4-csd02-prd01-13\n= ubl-2.4-csd02-tsc\n476e1ad  IDENTICAL TIPS", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        csd02 [label="★ ubl-2.4-csd02\n9b42a40  (188 commits)\n2023-07-25  (branch tip)", fillcolor="#1a4a1a", fontcolor="#7ee787", penwidth=2, color="#7ee787"];
        cs01work [label="ubl-2.4-cs01-work\n7c01887  (196 commits)\n2023-09-20", fillcolor="#1a3a1a", fontcolor="#7ee787"];

        pr27 [label="16ca084\n2023-09-26\nPR #27\nKEY MERGE:\ncs01-work + PR#26", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=octagon, penwidth=2, color="#58a6ff"];

        shared_b9df [label="b9df309\n2023-10-24\nLAST SHARED COMMIT\nbetween 2.4-cs01/os\nand 2.5 lineage", fillcolor="#1a2a3a", fontcolor="#ffa657", shape=ellipse, fontsize=9, penwidth=2, color="#ffa657"];

        cs01 [label="★ ubl-2.4-cs01\nRelease: b9df309 (17 Oct 2023)\nTip: 8c4d077  (213 commits)\n2024-06-24", fillcolor="#1a4a1a", fontcolor="#7ee787", penwidth=2, color="#7ee787"];

        os24fork [label="8c99636\n★ Release: UBL 2.4 OS\n20 Jun 2024", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=ellipse, penwidth=2, color="#7ee787"];
        os24 [label="ubl-2.4-os\n779bf4b  (220 commits)\n2025-03-23\n\"Retrying 2.4 OS publishing\"", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        osisopub [label="ubl-2.4-os-iso-pub\nc55958d  (228 commits)\n2025-06-20", fillcolor="#1a3a1a", fontcolor="#7ee787"];
    }

    // ---- UBL 2.5 lineage (main tree development) ----
    subgraph cluster_25_dev {
        label="UBL 2.5 development lineage";
        fontcolor="#79c0ff";
        fontsize=10;
        style=dashed;
        color="#1a2a3a";
        bgcolor="#0d1117";

        tsc25exp [label="tsc-ubl-2.5-experimental\n0b381cc  (216 commits)\n2023-10-12", fillcolor="#1a3a1a", fontcolor="#7ee787"];

        shared_retest [label="153236e\n2025-04-07\nShared by dev + retest", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=ellipse, fontsize=8];
        fork25dev [label="76dcc63\n2025-04-10\nDivergence: dev vs kenneth", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=ellipse, fontsize=8];

        kenneth [label="ubl-2.5-kenneth\n154a8bc  (240 commits)\n2025-04-30", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        dev25 [label="ubl-2.5-dev\n39fae0d  (272 commits)\n2025-06-11", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        xsddoc [label="UBL-433-xsd-doc\n4c0ffc3  (275 commits)\n2025-07-06\nFork point for ubl-2.5", fillcolor="#1a3a1a", fontcolor="#7ee787", penwidth=2, color="#ffa657"];
    }

    retest [label="retest\n15c714c  (227 commits)\n2025-05-23", fillcolor="#1a3a1a", fontcolor="#7ee787"];

    // ---- Recovered history (40 commits, were unreachable) ----
    recovered [label="40 recovered commits\n48ad2d8 → dc1249d\nJul-Aug 2025\n(were unreachable due to\nshallow fetch boundary;\nnow part of ubl-2.5\nfirst-parent chain)", fillcolor="#2a1a2a", fontcolor="#d2a8ff", style="filled,dashed", fontsize=9];

    // ---- UBL 2.5 release branch ----
    subgraph cluster_25_release {
        label="UBL 2.5 releases (all on ubl-2.5 branch)";
        fontcolor="#79c0ff";
        fontsize=10;
        style=dashed;
        color="#1a3a1a";
        bgcolor="#0d1117";

        pr28 [label="0b44c38\n★ UBL 2.5 CSD01\n20 Aug 2025\nMerge PR #28", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=octagon, penwidth=2, color="#7ee787"];

        python25 [label="ubl-2.5-python\n6c4d314  (98 commits)\n2025-11-17", fillcolor="#1a3a1a", fontcolor="#7ee787"];

        branchpoint [label="b122814\n★ UBL 2.5 CSD02\n03 Dec 2025", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=ellipse, penwidth=2, color="#7ee787"];

        retry [label="ubl-2.5-retry\nf738ca3  2026-01-21", fillcolor="#1a3a1a", fontcolor="#7ee787", fontsize=8];
        servertest [label="server-test\n68aabb9  2026-01-21", fillcolor="#1a3a1a", fontcolor="#7ee787", fontsize=8];
        layout2025 [label="ubl-2.5-2025-layout\n5e984b8  2026-01-15", fillcolor="#1a3a1a", fontcolor="#7ee787", fontsize=8];
        kentest_new [label="kentest\n7f8f046  2026-01-21\nFORCE-PUSHED\n(was on 2.4-cs01)", fillcolor="#3a2a0a", fontcolor="#d29922", fontsize=8];

        pr37 [label="27b46f5\nPR #37\n\"2025 layout\"\n→ ubl-2.5", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=octagon, fontsize=8];

        ubl25 [label="★ ubl-2.5\n3d81e8a  (174 commits)\n11 Feb 2026\nUBL 2.5 CSD03\n(branch tip)", fillcolor="#1a4a1a", fontcolor="#7ee787", penwidth=2, color="#7ee787"];
    }

    // ============================================================
    // EDGES
    // ============================================================

    // UBL 2.3
    root -> csd05copy [label=" 7 commits", fontcolor="#8b949e", color="#3a5a3a"];
    csd05copy -> cs02 [label=" +1", fontcolor="#8b949e", color="#3a5a3a"];
    csd05copy -> pr1 [label=" PR #1", fontcolor="#58a6ff", color="#58a6ff", style=dashed];
    cs02 -> pivot [label=" +4", fontcolor="#8b949e", color="#3a5a3a"];
    pivot -> os23 [label=" +4", fontcolor="#8b949e", color="#3a5a3a"];
    os23 -> osiso23 [label=" identical", fontcolor="#8b949e", color="#3a5a3a", style=dashed];
    os23 -> review [label=" ancestor", fontcolor="#8b949e", color="#3a5a3a"];
    pr1 -> review [style=invis];
    pivot -> main [label=" +1", fontcolor="#8b949e", color="#3a5a3a"];

    // UBL 2.4
    pivot -> csd01wd01 [label=" +27", fontcolor="#8b949e", color="#3a5a3a"];
    csd01wd01 -> csd01wd02 [label=" +103\nPRs #4-#20", fontcolor="#8b949e", color="#3a5a3a"];
    csd01wd02 -> csd01 [label=" PRs #21,#23,#24", fontcolor="#8b949e", color="#3a5a3a"];
    csd01wd02 -> csd02prd [label=" +41", fontcolor="#8b949e", color="#3a5a3a"];
    csd02prd -> csd02 [label=" +5", fontcolor="#8b949e", color="#3a5a3a"];
    csd02 -> cs01work [label=" +8", fontcolor="#8b949e", color="#3a5a3a"];
    cs01work -> pr27 [label=" parent 1", fontcolor="#58a6ff", color="#58a6ff", style=bold, penwidth=2];
    csd01 -> pr27 [label=" parent 2\n(PR#26)", fontcolor="#58a6ff", color="#58a6ff", style=dashed];
    pr27 -> shared_b9df [label=" +2 shared", fontcolor="#8b949e", color="#3a5a3a"];
    shared_b9df -> cs01 [label=" → 2.4-cs01\n+7", fontcolor="#8b949e", color="#3a5a3a"];
    cs01 -> os24fork [label=" +14", fontcolor="#8b949e", color="#3a5a3a"];
    os24fork -> os24 [label=" +continued", fontcolor="#8b949e", color="#3a5a3a"];
    os24fork -> osisopub [label=" fork", fontcolor="#8b949e", color="#3a5a3a"];

    // UBL 2.5 development
    shared_b9df -> tsc25exp [label=" → 2.5 lineage\n+14", fontcolor="#58a6ff", color="#58a6ff", style=bold, penwidth=2];
    pr27 -> tsc25exp [label=" diverged", fontcolor="#8b949e", color="#3a5a3a"];
    tsc25exp -> shared_retest [label=" many commits", fontcolor="#8b949e", color="#3a5a3a"];
    shared_retest -> retest [label=" +2", fontcolor="#8b949e", color="#3a5a3a"];
    shared_retest -> fork25dev [label=" +3 days", fontcolor="#8b949e", color="#3a5a3a"];
    fork25dev -> kenneth [label=" +12", fontcolor="#8b949e", color="#3a5a3a"];
    fork25dev -> dev25 [label=" +32", fontcolor="#8b949e", color="#3a5a3a"];
    dev25 -> xsddoc [label=" +3", fontcolor="#8b949e", color="#3a5a3a"];

    // Recovered history connects xsddoc to ubl-2.5
    xsddoc -> recovered [label=" 40 commits\n(recovered)", fontcolor="#d2a8ff", color="#d2a8ff", style=bold, penwidth=2];
    recovered -> pr28 [label=" +8", fontcolor="#8b949e", color="#3a5a3a"];

    // UBL 2.5 releases
    pr28 -> python25 [label=" fork", fontcolor="#8b949e", color="#484f58", style=dotted];
    pr28 -> branchpoint [label=" +50", fontcolor="#8b949e", color="#3a5a3a"];
    branchpoint -> retry [label=" +2", fontcolor="#8b949e", color="#484f58", style=dotted];
    branchpoint -> servertest [label=" fork", fontcolor="#8b949e", color="#484f58", style=dotted];
    branchpoint -> layout2025 [label=" +6", fontcolor="#8b949e", color="#484f58", style=dotted];
    layout2025 -> kentest_new [label=" +2", fontcolor="#8b949e", color="#484f58", style=dotted];
    layout2025 -> pr37 [label=" PR#37", fontcolor="#58a6ff", color="#58a6ff", style=dashed];
    pr37 -> ubl25 [label=" +10 CSD03", fontcolor="#8b949e", color="#3a5a3a"];
    branchpoint -> ubl25 [label=" +46\n(incl PR#37)", fontcolor="#8b949e", color="#3a5a3a"];
}
