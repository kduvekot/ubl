digraph UBL_Trunk {
    rankdir=TB;
    bgcolor="#0d1117";
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9, style=filled, margin="0.10,0.05"];
    edge [fontname="Helvetica", fontsize=7];
    label="oasis-tcs/ubl — Trunk View\n328 first-parent commits from root (71129c9) to current tip (3d81e8a)\nBranches fork off the trunk; some merge back (blue), some are dead ends.\n★ = release commit verified against official OASIS zip\n(generated 2026-04-02)";
    labelloc=t; labeljust=l; fontcolor="#58a6ff"; fontsize=12;
    splines=true;
    nodesep=0.5;
    ranksep=0.4;

    // ========== TRUNK (vertical spine) ==========
    // Only milestone/release commits shown; intermediate commits collapsed

    t0 [label="71129c9  11 Apr 2018\nRepo created (Robin Cover)", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=box];

    t5 [label="#5  6d153bf  16 May 2021\n2.3 source loaded into repo", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=box];

    t7 [label="#7  79201eb  23 May 2021\nMerge: cs02 → review", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=box];

    t9 [label="#9  f71d2be  26 May 2021\nPIVOT — ancestor of main,\nall 2.4 and 2.5 branches", fillcolor="#1a2a3a", fontcolor="#ffa657", shape=box, penwidth=2, color="#ffa657"];

    t36 [label="#36  21efa9e  01 Jun 2021\ncsd01wd01 tip", fillcolor="#161b22", fontcolor="#8b949e", shape=box];

    t55 [label="#38–55  PRs #4–#17\n14 merges, 58 side-branch commits\n2.4 CSD01 development\nOct 2021 – Feb 2023", fillcolor="#161b22", fontcolor="#8b949e", shape=box];

    t63 [label="#63  35bbc9f  07 Feb 2023\nPR#21: csd01wd02 merged back\n(27 commits)", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=box];

    t68 [label="★ #68  2e3c601  08 Feb 2023\nUBL 2.4 CSD01", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=2, color="#7ee787"];

    t93 [label="★ #93  9b42a40  26 Jul 2023\nUBL 2.4 CSD02", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=2, color="#7ee787"];

    t102 [label="#102  16ca084  26 Sep 2023\nPR#27: KEY MERGE\ncsd01 + cs01-work → trunk\n(5 side-branch commits)", fillcolor="#1a2a3a", fontcolor="#ffa657", shape=box, penwidth=2, color="#ffa657"];

    t106 [label="★ #106  b9df309  17 Oct 2023\nUBL 2.4 CS01\n(last shared 2.4/2.5 commit)", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=2, color="#7ee787"];

