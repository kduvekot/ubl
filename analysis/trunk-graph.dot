    // ========== MERGE-BACK BRANCHES ==========
    // (fork off trunk, then merge back via PR)

    mb_wd02 [label="ubl-2.4-csd01wd02\nPR#21  (27 commits)", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=box];
    mb_python [label="ubl-2.5-python\nPR#32  (52 commits)", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=box];
    mb_layout [label="ubl-2.5-2025-layout\nPR#37  (7 commits)", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=box];

