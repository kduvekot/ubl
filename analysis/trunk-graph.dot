    t215 [label="#215  dc1249d  06 Aug 2025\n(was shallow boundary;\n40 recovered commits\nreconnect the tree)", fillcolor="#2a1a2a", fontcolor="#d2a8ff", shape=box, style="filled,dashed"];

    t242 [label="★ #242  0b44c38  20 Aug 2025\nUBL 2.5 CSD01\n(merge PR#28)", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=2, color="#7ee787"];

    t307 [label="★ #307  b122814  03 Dec 2025\nUBL 2.5 CSD02", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=2, color="#7ee787"];

    t327 [label="★ #327  3d81e8a  11 Feb 2026\nUBL 2.5 CSD03\n(current branch tip)", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=3, color="#7ee787"];

