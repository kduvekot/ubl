    dead_csd05 [label="ubl-2.3-csd05-copy\n★ 2.3 CSD05  12 May 2021\n(1 commit)", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=2, color="#7ee787"];
    dead_cs02 [label="ubl-2.3-cs02\n★ 2.3 CS02  25 May 2021\n(2 commits, also merges\nback at #7)", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=2, color="#7ee787"];
    dead_os [label="ubl-2.3-os (+os-iso)\n★ 2.3 OS  15 Jun 2021\n(2 commits)", fillcolor="#1a4a1a", fontcolor="#7ee787", shape=box, penwidth=2, color="#7ee787"];
    dead_review [label="review\n(5 commits)", fillcolor="#161b22", fontcolor="#8b949e", shape=box];
