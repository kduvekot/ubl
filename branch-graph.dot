digraph UBL_Branch_Graph {
    rankdir=TB;
    bgcolor="#0d1117";
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.15,0.08"];
    edge [fontname="Helvetica", fontsize=8, color="#484f58"];

    // ===== LEGEND =====
    subgraph cluster_legend {
        label="Legend";
        labeljust=l;
        fontcolor="#58a6ff";
        fontsize=12;
        style=dashed;
        color="#30363d";
        bgcolor="#161b22";

        leg1 [label="Branch tip (main tree)", fillcolor="#1a3a1a", fontcolor="#7ee787", shape=box];
        leg2 [label="Branch tip (disconnected tree)", fillcolor="#3a1a1a", fontcolor="#f85149", shape=box];
        leg3 [label="Key commit / merge point", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=ellipse];
        leg4 [label="Force-pushed branch", fillcolor="#3a2a0a", fontcolor="#d29922", shape=box];
        leg5 [label="39-file content gap\n(no git parentage)", fillcolor="#3a2a0a", fontcolor="#d29922", shape=diamond];
        leg6 [label="Merge (PR)", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=octagon];
        leg1 -> leg2 -> leg3 -> leg4 -> leg5 -> leg6 [style=invis];
    }

    // ===== MAIN TREE =====
    subgraph cluster_main {
        label="MAIN TREE  (root: 71129c9, 2018-04-11)  —  All branches trace back to this root";
        labeljust=l;
        fontcolor="#7ee787";
        fontsize=12;
        style=dashed;
        color="#1a3a1a";
        bgcolor="#0d1117";

        // Root
        root [label="71129c9\n2018-04-11\nInitial repo\n(Robin Cover)", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=ellipse];

        // UBL 2.3 chain
        csd05copy [label="ubl-2.3-csd05-copy\n57dda2e  (7 commits)\n2021-05-16", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        cs02 [label="ubl-2.3-cs02\n47eb1f5  (8 commits)\n2021-05-23", fillcolor="#1a3a1a", fontcolor="#7ee787"];

        // Pivot
        pivot [label="f71d2be\n2021-05-26\n\"Add polish to README\"\nPIVOT — ancestor of 17 branches", fillcolor="#1a2a3a", fontcolor="#ffa657", shape=ellipse, penwidth=2, color="#ffa657"];

        // Main branch
        main [label="main\nc12b81a  (13 commits)\n2025-10-08", fillcolor="#1a3a1a", fontcolor="#7ee787"];

        // Review
        review [label="review\n876778c  (19 commits)\n2023-02-01", fillcolor="#1a3a1a", fontcolor="#7ee787"];

        // UBL 2.3 OS
        os23 [label="ubl-2.3-os\nbc99520  (16 commits)\n2021-06-18", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        osiso23 [label="ubl-2.3-os-iso\nbc99520  (= ubl-2.3-os)\n2021-06-18", fillcolor="#1a3a1a", fontcolor="#7ee787"];

        // Retest
        retest [label="retest\n15c714c  (227 commits)\n2025-05-23", fillcolor="#1a3a1a", fontcolor="#7ee787"];

        // UBL 2.4 chain
        subgraph cluster_24 {
            label="UBL 2.4 lineage";
            fontcolor="#79c0ff";
            fontsize=10;
            style=dashed;
            color="#1a2a3a";
            bgcolor="#0d1117";

            csd01wd01 [label="ubl-2.4-csd01wd01\n21efa9e  (39 commits)\n2021-06-01", fillcolor="#1a3a1a", fontcolor="#7ee787"];
            csd01wd02 [label="ubl-2.4-csd01wd02\n33d4527  (142 commits)\n2023-02-07", fillcolor="#1a3a1a", fontcolor="#7ee787"];
            csd01 [label="ubl-2.4-csd01\n0b0b0b3  (168 commits)\n2023-09-26", fillcolor="#1a3a1a", fontcolor="#7ee787"];
            csd02prd [label="ubl-2.4-csd02-prd01-13\n= ubl-2.4-csd02-tsc\n476e1ad  (183 commits)\n2023-07-04", fillcolor="#1a3a1a", fontcolor="#7ee787"];
            csd02 [label="ubl-2.4-csd02\n9b42a40  (188 commits)\n2023-07-25", fillcolor="#1a3a1a", fontcolor="#7ee787"];
            cs01work [label="ubl-2.4-cs01-work\n7c01887  (196 commits)\n2023-09-20", fillcolor="#1a3a1a", fontcolor="#7ee787"];

            // Shared commit between 2.4 and 2.5
            shared_b9df [label="b9df309\n2023-10-24\n\"Update UBL.xml\"\nShared by 2.4-cs01,\n2.4-os and 2.5-dev", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=ellipse, fontsize=8];

            cs01 [label="ubl-2.4-cs01\n8c4d077  (213 commits)\n2024-06-24", fillcolor="#1a3a1a", fontcolor="#7ee787"];
            os24 [label="ubl-2.4-os\n779bf4b  (220 commits)\n2025-03-23", fillcolor="#1a3a1a", fontcolor="#7ee787"];
            osisopub [label="ubl-2.4-os-iso-pub\nc55958d  (228 commits)\n2025-06-20", fillcolor="#1a3a1a", fontcolor="#7ee787"];

            // Fork point for os vs os-iso-pub
            os24fork [label="8c99636\n2024-06-23\nDivergence point", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=ellipse, fontsize=8];
        }

        // UBL 2.5 main tree
        subgraph cluster_25_main {
            label="UBL 2.5 lineage (main tree)";
            fontcolor="#79c0ff";
            fontsize=10;
            style=dashed;
            color="#1a2a3a";
            bgcolor="#0d1117";

            // The merge that connects 2.4 to 2.5
            merge27 [label="16ca084\n2023-09-26\nMerge PR #27\n\"test-2.4cs01\"\n\nMERGES 2.4-cs01-work\nINTO 2.5 lineage", fillcolor="#1a2a3a", fontcolor="#58a6ff", shape=octagon, penwidth=2, color="#58a6ff"];

            tsc25exp [label="tsc-ubl-2.5-experimental\n0b381cc  (216 commits)\n2023-10-12", fillcolor="#1a3a1a", fontcolor="#7ee787"];
            fork25dev [label="76dcc63\n2025-04-10\n\"Repair JSON schemas\"\nDivergence point", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=ellipse, fontsize=8];
            kenneth [label="ubl-2.5-kenneth\n154a8bc  (240 commits)\n2025-04-30", fillcolor="#1a3a1a", fontcolor="#7ee787"];
            dev25 [label="ubl-2.5-dev\n39fae0d  (272 commits)\n2025-06-11", fillcolor="#1a3a1a", fontcolor="#7ee787", penwidth=2, color="#d29922"];
            xsddoc [label="UBL-433-xsd-doc\n4c0ffc3  (275 commits)\n2025-07-06", fillcolor="#1a3a1a", fontcolor="#7ee787"];
        }

        // Old kentest (pre-force-push)
        old_kentest [label="OLD kentest\n6cc2cf5  (2024-05-30)\n\"Use version of API interface\"\n(pre-force-push, still in repo)", fillcolor="#3a2a0a", fontcolor="#d29922"];
    }

    // ===== 39-FILE GAP =====
    gap [label="39-FILE CONTENT GAP\n\n12 files added (2.5 artwork, DebitNote example, LICENSE)\n11 files deleted (2.0/2.2 artwork, old example, version file)\n16 files modified (README, UBL.xml, configs, XSL tools)\n\nContent taken from ubl-2.5-dev → dc1249d\nbut git parentage was NOT preserved\n(fresh git init / import)", fillcolor="#3a2a0a", fontcolor="#d29922", shape=diamond, fontsize=9, margin="0.3,0.2"];

    // ===== DISCONNECTED TREE =====
    subgraph cluster_disconnected {
        label="DISCONNECTED TREE  (root: dc1249d, 2025-08-06)  —  No git link to main tree";
        labeljust=l;
        fontcolor="#f85149";
        fontsize=12;
        style=dashed;
        color="#3a1a1a";
        bgcolor="#0d1117";

        dc_root [label="dc1249d\n2025-08-06\n\"Updated with Invoice\nStatus Response\"\n(Kenneth Bengtsson)\nORPHAN ROOT — no parent", fillcolor="#3a1a1a", fontcolor="#f85149", shape=ellipse, penwidth=2, color="#f85149"];

        python25 [label="ubl-2.5-python\n6c4d314  (98 commits)\n2025-11-17\nFORCE-PUSHED: was be9aa9d\n(20 commits rolled back)", fillcolor="#3a2a0a", fontcolor="#d29922"];

        branchpoint [label="b122814\n2025-12-03\nBranching point\nfor 4 branches", fillcolor="#1a2a3a", fontcolor="#79c0ff", shape=ellipse, fontsize=8];

        retry [label="ubl-2.5-retry\nf738ca3  (149 commits)\n2026-01-21", fillcolor="#3a1a1a", fontcolor="#f85149"];
        servertest [label="server-test\n68aabb9  (148 commits)\n2026-01-21", fillcolor="#3a1a1a", fontcolor="#f85149"];
        layout2025 [label="ubl-2.5-2025-layout\n5e984b8  (154 commits)\n2026-01-15", fillcolor="#3a1a1a", fontcolor="#f85149"];
        kentest_new [label="kentest\n7f8f046  (156 commits)\n2026-01-21\nFORCE-PUSHED from\nmain tree (6cc2cf5)", fillcolor="#3a2a0a", fontcolor="#d29922"];
        ubl25 [label="ubl-2.5\n3d81e8a  (174 commits)\n2026-02-09\nMOST RECENT BRANCH\n+2700 build output files", fillcolor="#3a1a1a", fontcolor="#f85149", penwidth=2, color="#f85149"];
    }

    // ===== EDGES: MAIN TREE =====
    root -> csd05copy [label=" 7 commits", fontcolor="#8b949e", color="#3a5a3a"];
    csd05copy -> cs02 [label=" +1", fontcolor="#8b949e", color="#3a5a3a"];
    cs02 -> pivot [label=" +4", fontcolor="#8b949e", color="#3a5a3a"];

    pivot -> main [label=" +1", fontcolor="#8b949e", color="#3a5a3a"];
    pivot -> review [label=" +7", fontcolor="#8b949e", color="#3a5a3a"];
    pivot -> os23 [label=" +4", fontcolor="#8b949e", color="#3a5a3a"];
    os23 -> osiso23 [label=" identical", fontcolor="#8b949e", color="#3a5a3a", style=dashed];
    pivot -> retest [label=" +215", fontcolor="#8b949e", color="#3a5a3a"];

    // 2.4 edges
    pivot -> csd01wd01 [label=" +27", fontcolor="#8b949e", color="#3a5a3a"];
    csd01wd01 -> csd01wd02 [label=" +103", fontcolor="#8b949e", color="#3a5a3a"];
    csd01wd02 -> csd01 [label=" +26\n(diverged)", fontcolor="#8b949e", color="#3a5a3a"];
    csd01wd02 -> csd02prd [label=" +41", fontcolor="#8b949e", color="#3a5a3a"];
    csd02prd -> csd02 [label=" +5", fontcolor="#8b949e", color="#3a5a3a"];
    csd02 -> cs01work [label=" +8", fontcolor="#8b949e", color="#3a5a3a"];

    // 2.4 cs01-work is the KEY LINK — it gets merged into 2.5-dev
    cs01work -> merge27 [label=" merged as\nparent 1\nof PR #27", fontcolor="#58a6ff", color="#58a6ff", style=bold, penwidth=2];

    // After the merge, 2.4 and 2.5 share commit b9df309
    cs01work -> shared_b9df [label=" continues\nas 2.4", fontcolor="#8b949e", color="#3a5a3a"];
    shared_b9df -> cs01 [label=" +17", fontcolor="#8b949e", color="#3a5a3a"];
    shared_b9df -> os24fork [color="#3a5a3a"];
    shared_b9df -> os24 [label=" +24", fontcolor="#8b949e", color="#3a5a3a"];
    os24fork -> os24 [style=invis];
    os24fork -> osisopub [label=" diverged\n2024-06-23", fontcolor="#8b949e", color="#3a5a3a"];
    cs01 -> old_kentest [label=" ancestor", fontcolor="#d29922", color="#d29922", style=dashed];

    // b9df309 is also in ubl-2.5-dev (shared history after merge)
    shared_b9df -> merge27 [label=" also in\n2.5-dev\nhistory", fontcolor="#58a6ff", color="#58a6ff", style=dotted, constraint=false];

    // 2.5 main tree edges — merge27 has TWO parents
    // Parent 2 comes from the pre-existing 2.5 lineage (via earlier PRs)
    pivot -> merge27 [label=" parent 2:\nprior 2.5 work\n(PRs #4-#26)", fontcolor="#8b949e", color="#3a5a3a"];
    merge27 -> tsc25exp [label=" diverged", fontcolor="#8b949e", color="#3a5a3a"];
    merge27 -> fork25dev [color="#3a5a3a"];
    fork25dev -> kenneth [label=" +12", fontcolor="#8b949e", color="#3a5a3a"];
    fork25dev -> dev25 [label=" +32", fontcolor="#8b949e", color="#3a5a3a"];
    dev25 -> xsddoc [label=" +3", fontcolor="#8b949e", color="#3a5a3a"];

    // ===== THE GAP =====
    dev25 -> gap [label="content snapshot\ntaken from here\n(2025-06-11)", fontcolor="#d29922", color="#d29922", style=bold, penwidth=2];
    gap -> dc_root [label="committed as\norphan root\n(2025-08-06)", fontcolor="#d29922", color="#d29922", style=bold, penwidth=2];

    // ===== EDGES: DISCONNECTED TREE =====
    dc_root -> python25 [label=" 98 commits", fontcolor="#8b949e", color="#5a3a3a"];
    python25 -> branchpoint [label=" ~50 commits", fontcolor="#8b949e", color="#5a3a3a"];
    branchpoint -> retry [label=" +2", fontcolor="#8b949e", color="#5a3a3a"];
    branchpoint -> servertest [label=" +many", fontcolor="#8b949e", color="#5a3a3a"];
    branchpoint -> layout2025 [label=" +6", fontcolor="#8b949e", color="#5a3a3a"];
    layout2025 -> kentest_new [label=" +2", fontcolor="#8b949e", color="#5a3a3a"];
    layout2025 -> ubl25 [label=" +20", fontcolor="#8b949e", color="#5a3a3a"];

    // Force push arrows
    old_kentest -> kentest_new [label="FORCE\nPUSHED", fontcolor="#f85149", color="#f85149", style=dashed, penwidth=2, constraint=false];
}
